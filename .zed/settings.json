{
	"languages": {
		"Templ": {
			"language_servers": ["tailwindcss-language-server", "..."]
		}
	},
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"includeLanguages": {
					"templ": "html"
				},
				"experimental": {
					"classRegex": ["class=\"([^\"]*)\""]
				}
			}
		}
	}
}
