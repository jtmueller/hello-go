package views

import (
	"fmt"
	"hello-go/model"
)

// Page is the full document. HTMX swaps the Section on every interaction.
templ Page(v model.View) {
	@Layout("Todos") {
		@AddForm(v.Filter)
		@Section(v)
	}
}

// AddForm uses Alpine for a live character counter and to disable submit
// when empty; HTMX posts it and swaps the section.
templ AddForm(filter string) {
	<form
		class="mb-4 flex items-center gap-2"
		x-data="{ title: '', max: 80 }"
		hx-post={ "/todos?filter=" + filter }
		hx-target="#todo-section"
		hx-swap="outerHTML"
		@htmx:after-request="if ($event.detail.successful) title = ''"
	>
		<label class="input flex-1">
			<input
				name="title"
				x-model="title"
				:maxlength="max"
				placeholder="What needs doing?"
				autocomplete="off"
				autofocus
				class="grow"
			/>
			<span class="badge badge-ghost badge-sm" x-text="title.length + '/' + max"></span>
		</label>
		<button type="submit" :disabled="!title.trim()" class="btn btn-primary">Add</button>
	</form>
}

// Section is the swappable fragment: list + footer.
templ Section(v model.View) {
	<section id="todo-section" class="card bg-base-100 shadow-sm">
		if len(v.Todos) == 0 {
			<p class="p-6 text-center text-base-content/50">Nothing here. 🎉</p>
		} else {
			<ul class="list">
				for _, t := range v.Todos {
					@Item(t, v.Filter)
				}
			</ul>
		}
		<footer class="flex items-center justify-between gap-2 border-t border-base-300 px-3 py-2.5 text-sm">
			<span class="badge badge-neutral">{ fmt.Sprint(v.Remaining) } left</span>
			<nav class="tabs tabs-box tabs-sm">
				for _, f := range []string{"all", "active", "done"} {
					<a
						href={ templ.SafeURL("/?filter=" + f) }
						hx-get={ "/todos?filter=" + f }
						hx-target="#todo-section"
						hx-swap="outerHTML"
						hx-push-url={ "/?filter=" + f }
						class={ "tab", templ.KV("tab-active", f == v.Filter) }
					>{ f }</a>
				}
			</nav>
			<button
				class="btn btn-ghost btn-sm"
				hx-delete={ "/todos?filter=" + v.Filter }
				hx-target="#todo-section"
				hx-swap="outerHTML"
				hx-confirm="Clear all completed todos?"
			>Clear done</button>
		</footer>
	</section>
}

// Item uses Alpine for the inline-edit toggle; HTMX persists changes.
// Clicking the text toggles the todo via the checkbox's hx-post. The click is
// deferred 250ms so a double-click (which fires two clicks first) can cancel it
// and start editing instead of toggling.
templ Item(t model.Todo, filter string) {
	<li x-data="{ editing: false, timer: null }" class="list-row items-center">
		<input
			type="checkbox"
			checked?={ t.Done }
			x-ref="toggle"
			class="checkbox checkbox-primary"
			hx-post={ fmt.Sprintf("/todos/%d/toggle?filter=%s", t.ID, filter) }
			hx-trigger="change, toggle"
			hx-target="#todo-section"
			hx-swap="outerHTML"
		/>
		<span
			class={ "cursor-pointer", templ.KV("text-base-content/40 line-through", t.Done) }
			x-show="!editing"
			@click="timer = timer || setTimeout(() => { timer = null; htmx.trigger($refs.toggle, 'toggle') }, 250)"
			@dblclick="clearTimeout(timer); timer = null; editing = true; $nextTick(() => $refs.edit.focus())"
		>{ t.Title }</span>
		<form
			x-show="editing"
			x-cloak
			hx-put={ fmt.Sprintf("/todos/%d?filter=%s", t.ID, filter) }
			hx-target="#todo-section"
			hx-swap="outerHTML"
			@keydown.escape="editing = false"
		>
			<input
				name="title"
				x-ref="edit"
				value={ t.Title }
				maxlength="80"
				@blur="editing = false"
				class="input input-primary input-sm w-full"
			/>
		</form>
		<button
			title="Delete"
			class="btn btn-ghost btn-square btn-sm hover:btn-error"
			hx-delete={ fmt.Sprintf("/todos/%d?filter=%s", t.ID, filter) }
			hx-target="#todo-section"
			hx-swap="outerHTML"
		>✕</button>
	</li>
}
