package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="bg-base-200" x-data="{ dark: localStorage.getItem('dark') === '1' }" x-init="$watch('dark', v => localStorage.setItem('dark', v ? '1' : '0'))" :data-theme="dark ? 'dark' : 'light'" data-theme="light">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/vendor/htmx.min.js"></script>
			<script defer src="/static/vendor/alpine.min.js"></script>
		</head>
		<body class="min-h-screen">
			<main class="mx-auto my-12 max-w-xl px-4">
				<header class="navbar mb-4 px-0">
					<h1 class="navbar-start text-3xl font-bold">{ title }</h1>
					<button type="button" class="btn btn-ghost navbar-end w-auto ml-auto" @click="dark = !dark" x-text="dark ? '☀️ Light' : '🌙 Dark'"></button>
				</header>
				{ children... }
			</main>
		</body>
	</html>
}
