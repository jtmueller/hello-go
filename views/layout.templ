package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" x-data="{ dark: localStorage.getItem('dark') === '1' }" x-init="$watch('dark', v => localStorage.setItem('dark', v ? '1' : '0'))" :class="{ dark }">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script defer src="https://unpkg.com/alpinejs@3.14.8/dist/cdn.min.js"></script>
		</head>
		<body>
			<main>
				<header class="top">
					<h1>{ title }</h1>
					<button type="button" class="ghost" @click="dark = !dark" x-text="dark ? '☀️ Light' : '🌙 Dark'"></button>
				</header>
				{ children... }
			</main>
		</body>
	</html>
}
